---
import type { SiteContent } from "../i18n/types";
import PipelineDiagram from "./PipelineDiagram.astro";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { hero, pipeline } = content;
---

<div id="top" class="max-w-6xl mx-auto px-6 md:px-20 pt-20 pb-24 md:pt-28 md:pb-32">
  <p class="font-mono text-xs md:text-sm tracking-[0.2em] text-[var(--accent)] mb-6">
    [ {hero.kicker} ]
  </p>

  <h1 class="font-bold leading-[0.95] tracking-tight text-[15vw] sm:text-[9vw] md:text-[6.2rem] text-[var(--fg)]">
    {hero.name.split(" ")[0]}<br />{hero.name.split(" ")[1]}
  </h1>

  <p class="mt-8 font-bold uppercase leading-[1.1] text-2xl sm:text-3xl md:text-[2.4rem] max-w-3xl text-[var(--fg)]">
    {hero.statement}
  </p>

  <div class="mt-6 flex flex-col gap-4 max-w-2xl">
    {
      hero.bio.map((paragraph) => (
        <p class="text-base md:text-lg leading-[1.75] text-[var(--fg-muted)]">{paragraph}</p>
      ))
    }
  </div>

  <div class="mt-9 flex items-center gap-5 flex-wrap">
    <a
      href="#now"
      class="inline-flex items-center gap-2 font-mono text-sm px-5 py-3 bg-[var(--accent)] text-[var(--bg-panel)] font-medium transition-all hover:bg-[var(--accent-strong)]"
    >
      {hero.ctaTalk}
      <span aria-hidden="true">→</span>
    </a>
    <a
      href="#build"
      class="inline-flex items-center gap-2 font-mono text-sm px-5 py-3 border border-[var(--border-strong)] text-[var(--fg)] transition-all hover:border-[var(--accent)] hover:text-[var(--accent)]"
    >
      {hero.ctaWork}
    </a>
    <a
      href={hero.linkedin}
      target="_blank"
      rel="noreferrer"
      class="font-mono text-sm text-[var(--fg-subtle)] hover:text-[var(--fg)] transition-colors"
    >
      {hero.linkedinLabel}
    </a>
    <a
      href={hero.github}
      target="_blank"
      rel="noopener noreferrer"
      class="font-mono text-sm text-[var(--fg-subtle)] hover:text-[var(--fg)] transition-colors"
    >
      {hero.githubLabel}
    </a>
  </div>

  <div class="mt-20 md:mt-28">
    <PipelineDiagram stages={pipeline} label={hero.pipelineLabel} />
  </div>

  <div class="mt-10 flex flex-col sm:flex-row sm:items-center gap-2 sm:justify-between font-mono text-xs tracking-[0.14em] text-[var(--fg-subtle)]">
    <span>{hero.alwaysBuilding}</span>
    <span>{hero.location.toUpperCase()}</span>
  </div>
</div>
