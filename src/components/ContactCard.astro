---
import Card from "./Card.astro";
import SectionLabel from "./SectionLabel.astro";
import ContactForm from "./ContactForm";
import { hero } from "../data/content";
---

<div id="talk" style="scroll-margin-top: 24px;">
  <Card class="justify-between gap-0">
    <div>
      <SectionLabel>Say hi</SectionLabel>
      <p class="text-sm leading-[1.8] mb-5 text-[#777]">
        Got a problem worth solving? Drop a line.
      </p>
    </div>
    <ContactForm client:visible />
    <div class="mt-4 pt-4 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-[#E8E8E8]">
      <a
        href={`mailto:${hero.email}`}
        class="flex items-center gap-1.5 text-xs text-[#AAA] transition-colors hover:text-[#1A1A1A]"
      >
        {hero.email}
      </a>
      <a
        href={hero.linkedin}
        target="_blank"
        rel="noreferrer"
        class="flex items-center gap-1.5 text-xs text-[#AAA] transition-colors hover:text-[#1A1A1A]"
      >
        LinkedIn
      </a>
    </div>
  </Card>
</div>
