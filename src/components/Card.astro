---
interface Props {
  class?: string;
  id?: string;
  highlight?: boolean;
}

const { class: className = "", id, highlight = false } = Astro.props;
---

<div
  id={id}
  class:list={[
    "p-6 h-full flex flex-col bg-[var(--bg-elevated)] border transition-all duration-300",
    highlight
      ? "border-[var(--border-strong)] shadow-[0_0_28px_-8px_var(--accent)]"
      : "border-[var(--border)] hover:border-[var(--border-strong)]",
    className,
  ]}
>
  <slot />
</div>
