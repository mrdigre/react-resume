---
import type { SiteContent } from "../i18n/types";

interface Props {
  content: SiteContent;
  switchHref: string;
  switchLabel: string;
}

const { content, switchHref, switchLabel } = Astro.props;
const { hero, nav } = content;
---

<header
  class="sticky top-0 z-50 flex items-center justify-between px-6 md:px-20 py-4 border-b border-[var(--border)] bg-[var(--bg)]/85 backdrop-blur-md"
>
  <a href="#top" class="font-mono text-xs tracking-[0.14em] text-[var(--fg-muted)] hover:text-[var(--fg)] transition-colors">
    {hero.name.toUpperCase()}
  </a>

  <nav id="chapter-nav" class="hidden sm:flex items-center gap-8 font-mono text-xs tracking-[0.12em]">
    {
      nav.chapters.map((c) => (
        <a
          href={`#${c.id}`}
          data-chapter={c.id}
          class="chapter-link flex items-center gap-2 text-[var(--fg-subtle)] hover:text-[var(--fg)] transition-colors"
        >
          {c.label}
        </a>
      ))
    }
  </nav>

  <div class="flex items-center gap-4">
    <a
      href={switchHref}
      class="font-mono text-xs tracking-[0.1em] text-[var(--fg-subtle)] hover:text-[var(--accent)] transition-colors"
    >
      {switchLabel}
    </a>
    <a
      href="#now"
      class="font-mono text-xs tracking-[0.1em] px-3 py-1.5 border border-[var(--border-strong)] text-[var(--accent)] hover:bg-[var(--accent)] hover:text-[var(--bg-panel)] transition-colors"
    >
      {nav.contact}
    </a>
  </div>
</header>

<style>
  .chapter-link.is-active {
    color: var(--accent);
  }
  .chapter-link.is-active::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--accent);
    display: inline-block;
  }
</style>

<script>
  const sections = ["origin", "build", "now"]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  const links = document.querySelectorAll<HTMLAnchorElement>(".chapter-link");

  const setActive = (id: string) => {
    links.forEach((link) => {
      link.classList.toggle("is-active", link.dataset.chapter === id);
    });
  };

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) setActive(entry.target.id);
      });
    },
    { rootMargin: "-40% 0px -55% 0px" }
  );

  sections.forEach((section) => observer.observe(section));
</script>
