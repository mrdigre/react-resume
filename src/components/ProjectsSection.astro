---
import Card from "./Card.astro";
import SectionLabel from "./SectionLabel.astro";
import type { SiteContent } from "../i18n/types";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { projects } = content;
---

<div class="mb-16 md:mb-20">
  <SectionLabel index="02.3">{projects.label}</SectionLabel>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {
      projects.items.map((project) => (
        <Card class="justify-between gap-0" highlight={project.featured}>
          <div>
            <div class="flex items-start justify-between gap-3 mb-1">
              <p class="font-mono text-xs uppercase tracking-wider text-[var(--fg-subtle)]">
                {project.label}
              </p>
              {project.note && (
                <p class="font-mono text-[0.65rem] text-[var(--fg-subtle)] whitespace-nowrap">
                  {project.note}
                </p>
              )}
            </div>
            <h3 class="text-xl font-bold mb-1.5 leading-snug text-[var(--fg)]">{project.name}</h3>
            <p class="font-mono text-xs uppercase tracking-wider mb-4 text-[var(--accent)]">
              {project.tagline}
            </p>
            <p class="text-sm leading-[1.75] text-[var(--fg-muted)]">{project.description}</p>
          </div>
          <div class="w-full h-px my-5 bg-[var(--border)]" />
          <div class="flex flex-wrap gap-1.5 mb-4">
            {project.tech.map((t) => (
              <span class="font-mono text-[0.65rem] px-2 py-0.5 border border-[var(--border)] text-[var(--fg-subtle)]">
                {t}
              </span>
            ))}
          </div>
          {(project.github || project.url) && (
            <div class="flex gap-4">
              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-xs text-[var(--fg-muted)] hover:text-[var(--accent)] transition-colors"
                >
                  {projects.githubLink}
                </a>
              )}
              {project.url && (
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-xs text-[var(--fg-muted)] hover:text-[var(--accent)] transition-colors"
                >
                  {projects.visitSite}
                </a>
              )}
            </div>
          )}
        </Card>
      ))
    }
  </div>
</div>
