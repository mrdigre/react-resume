---
import Card from "./Card.astro";
import SectionLabel from "./SectionLabel.astro";
import { terminalCommands } from "../data/content";

const origin = terminalCommands.origin.replace(/^> The Origin Story\n\n/, "");
---

<div class="max-w-5xl mx-auto mb-4">
  <Card>
    <SectionLabel>The Origin Story</SectionLabel>
    <pre class="whitespace-pre-wrap font-mono text-sm leading-relaxed text-[#444]">{origin}</pre>
  </Card>
</div>
