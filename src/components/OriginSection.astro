---
import SectionLabel from "./SectionLabel.astro";
import type { SiteContent } from "../i18n/types";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { originStory } = content;
---

<section id="origin" class="max-w-6xl mx-auto px-6 md:px-20 py-20 md:py-28 scroll-mt-20">
  <SectionLabel index="01">{originStory.label}</SectionLabel>

  <div class="grid grid-cols-1 md:grid-cols-[repeat(5,1fr)] gap-6 md:gap-4">
    {
      originStory.paragraphs.map((p) => (
        <div class="border-t border-[var(--border)] pt-4">
          <p class="font-mono text-xs tracking-[0.1em] text-[var(--accent)] mb-3">{p.year}</p>
          <p class="font-semibold text-sm mb-2 text-[var(--fg)]">{p.title}</p>
          <p class="text-sm leading-[1.75] text-[var(--fg-muted)]">{p.text}</p>
        </div>
      ))
    }
  </div>
</section>
