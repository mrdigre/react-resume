---
import { pipeline } from "../data/content";

const n = pipeline.length;
---

<div>
  <p class="font-mono text-xs tracking-[0.14em] text-[var(--fg-subtle)] mb-6">// CAREER_PIPELINE</p>
  <div class="relative w-full overflow-x-auto">
    <svg viewBox={`0 0 1200 90`} class="w-full min-w-[640px] h-auto" preserveAspectRatio="xMinYMid meet">
      <line x1="30" y1="46" x2="1170" y2="46" stroke="var(--border-strong)" stroke-width="1.5" opacity="0.5" />
      <line
        x1="30"
        y1="46"
        x2="1170"
        y2="46"
        stroke="var(--accent)"
        stroke-width="1.5"
        stroke-dasharray="2 10"
        opacity="0.7"
      />
      {
        pipeline.map((stage, i) => {
          const x = 30 + (i * (1140 / (n - 1)));
          const r = stage.emphasis ? 9 : 6;
          return (
            <g class="font-mono">
              <circle
                cx={x}
                cy="46"
                r={r}
                fill="var(--bg-panel)"
                stroke={stage.emphasis ? "var(--accent-strong)" : "var(--accent)"}
                stroke-width="2"
              />
              <text
                x={x}
                y="22"
                text-anchor={i === 0 ? "start" : i === n - 1 ? "end" : "middle"}
                font-size="13"
                fill={stage.emphasis ? "var(--accent-strong)" : "var(--fg-muted)"}
              >
                {stage.label.toUpperCase()}
              </text>
              <text
                x={x}
                y="72"
                text-anchor={i === 0 ? "start" : i === n - 1 ? "end" : "middle"}
                font-size="11"
                fill="var(--fg-subtle)"
              >
                {stage.period}
              </text>
            </g>
          );
        })
      }
    </svg>
  </div>
</div>
