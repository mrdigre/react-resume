---
import Card from "./Card.astro";
import SectionLabel from "./SectionLabel.astro";
import { agentMethod } from "../data/content";
---

<div class="mb-16 md:mb-20">
  <SectionLabel index="02.1">{agentMethod.label}</SectionLabel>

  <p class="text-sm md:text-base leading-[1.75] max-w-3xl text-[var(--fg-subtle)] mb-8">
    {agentMethod.intro}
  </p>

  <Card highlight class="p-8 md:p-10">
    <h3 class="font-bold text-2xl md:text-3xl leading-tight max-w-3xl text-[var(--fg)]">
      {agentMethod.headline}
    </h3>
    <p class="mt-5 text-sm md:text-base leading-[1.8] max-w-3xl text-[var(--fg-muted)]">
      {agentMethod.body}
    </p>

    <div class="mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
      {
        agentMethod.steps.map((step, i) => (
          <div class="relative border border-[var(--border)] p-4 bg-[var(--bg-panel)]">
            <p class="font-mono text-xs text-[var(--accent)] mb-2">
              {String(i + 1).padStart(2, "0")}
            </p>
            <p class="font-semibold text-sm text-[var(--fg)] mb-1.5">{step.label}</p>
            <p class="text-xs leading-[1.6] text-[var(--fg-subtle)]">{step.detail}</p>
          </div>
        ))
      }
    </div>
  </Card>
</div>
