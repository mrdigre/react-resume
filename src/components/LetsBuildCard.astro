---
import Card from "./Card.astro";
import ContactForm from "./ContactForm";
import { letsBuild, hero } from "../data/content";
---

<Card class="justify-between gap-0" highlight>
  <div>
    <h3 class="font-bold text-2xl md:text-3xl leading-tight text-[var(--fg)]">
      {letsBuild.header}
    </h3>
    <p class="font-mono text-xs uppercase tracking-wider mt-2 mb-4 text-[var(--accent)]">
      {letsBuild.tag}
    </p>
    <p class="text-sm leading-[1.8] mb-6 text-[var(--fg-muted)]">
      {letsBuild.body}
    </p>
  </div>

  <ContactForm client:visible />

  <div class="mt-4 pt-4 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-[var(--border)]">
    <a
      href={`mailto:${hero.email}`}
      class="font-mono text-xs text-[var(--fg-subtle)] transition-colors hover:text-[var(--accent)]"
    >
      {hero.email}
    </a>
    <a
      href={hero.linkedin}
      target="_blank"
      rel="noreferrer"
      class="font-mono text-xs text-[var(--fg-subtle)] transition-colors hover:text-[var(--accent)]"
    >
      LinkedIn
    </a>
  </div>
</Card>
