---
import { Analytics } from "@vercel/analytics/react";
import Layout from "../../layouts/Layout.astro";
import ChapterNav from "../../components/ChapterNav.astro";
import Hero from "../../components/Hero.astro";
import OriginSection from "../../components/OriginSection.astro";
import AgenticSection from "../../components/AgenticSection.astro";
import SkillsSection from "../../components/SkillsSection.astro";
import ProjectsSection from "../../components/ProjectsSection.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import CurrentRoleCard from "../../components/CurrentRoleCard.astro";
import LetsBuildCard from "../../components/LetsBuildCard.astro";
import { content } from "../../i18n/es";
---

<Layout lang="es" path="/es/" title={content.meta.title} description={content.meta.description} jobTitle={content.meta.jobTitle}>
  <ChapterNav content={content} switchHref="/" switchLabel="EN" />

  <Hero content={content} />

  <OriginSection content={content} />

  <section id="build" class="max-w-6xl mx-auto px-6 md:px-20 py-20 md:py-28 scroll-mt-20">
    <SectionLabel index="02">{content.sections.build}</SectionLabel>
    <AgenticSection content={content} />
    <SkillsSection content={content} />
    <ProjectsSection content={content} />
  </section>

  <section id="now" class="max-w-6xl mx-auto px-6 md:px-20 py-20 md:py-28 scroll-mt-20">
    <SectionLabel index="03">{content.sections.now}</SectionLabel>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <CurrentRoleCard content={content} />
      <LetsBuildCard content={content} />
    </div>
  </section>

  <footer class="max-w-6xl mx-auto px-6 md:px-20 py-10 border-t border-[var(--border)] flex flex-col sm:flex-row items-center justify-between gap-3">
    <p class="font-mono text-xs text-[var(--fg-subtle)]">
      {content.hero.name} · {new Date().getFullYear()}
    </p>
    <p class="font-mono text-xs text-[var(--fg-subtle)]">{content.footer.alwaysBuilding}</p>
  </footer>

  <Analytics client:load />
</Layout>
